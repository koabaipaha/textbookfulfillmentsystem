modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "disambiguation: FastAPI"

[[workflows.workflow]]
name = "disambiguation: FastAPI"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd services/disambiguation && python -m uvicorn app.main:app --host 0.0.0.0 --port 8090"
waitForPort = 8090

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-sheet:1.0.0", "google-mail:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 4200

[[ports]]
localPort = 8090
externalPort = 3001

[[ports]]
localPort = 8091
externalPort = 3002

[[ports]]
localPort = 22629
externalPort = 3000

[[ports]]
localPort = 22630
externalPort = 3003

[nix]
channel = "stable-25_05"
packages = ["libxcrypt", "rapidfuzz-cpp", "taskflow"]
